<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Themed dialog used by the date + time pickers, styled to match the M3 UI:
         baseline teal accent (the app palette itself follows the device wallpaper on
         Android 12+), the M3 28dp dialog shape, and a consistent minimum width. -->
    <style name="PickerDialogTheme" parent="@android:style/Theme.Material.Light.Dialog">
        <item name="android:colorAccent">#00695C</item>
        <item name="android:colorPrimary">#00695C</item>
        <item name="android:windowBackground">@drawable/dialog_bg_light</item>
        <item name="android:windowMinWidthMajor">300dp</item>
        <item name="android:windowMinWidthMinor">300dp</item>
    </style>

    <style name="PickerDialogThemeDark" parent="@android:style/Theme.Material.Dialog">
        <item name="android:colorAccent">#4DB6AC</item>
        <item name="android:colorPrimary">#4DB6AC</item>
        <item name="android:windowBackground">@drawable/dialog_bg_dark</item>
        <item name="android:windowMinWidthMajor">300dp</item>
        <item name="android:windowMinWidthMinor">300dp</item>
    </style>
</resources>