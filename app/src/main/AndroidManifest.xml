<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PINS_WIDGETS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- No Auto Backup / device-transfer. With this on, Android silently restores
         hours_tracker.db and the hours_tracker prefs at install, so a "clean
         install" reappears with the previous data and the old pay period. The
         JSON backup in Settings -> Backup is the only intended way data comes
         back. Cost: losing the phone loses the data unless a file was saved. -->
    <application
        android:label="Hours Tracker"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode|orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="timer_status_shows_running_or_paused" />
        </service>

        <receiver
            android:name=".Widget3x1Provider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <category android:name="android.appwidget.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_3x1_info" />
        </receiver>

        <!-- Daily automatic backup. exported=false: the alarm PendingIntent is
             this app's own, and BOOT_COMPLETED is a protected broadcast the
             system delivers straight to it. Runs the same JSON build as the
             manual button, writing to the SAF destination chosen in Settings. -->
        <receiver
            android:name=".AutoBackupReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Native stand-in for FileProvider. exported=false + grantUriPermissions:
             only explicitly-granted, temporary read access to files under the
             app's own external directory (Export/, Backup/), so ACTION_SEND
             sharing works by passing a file:// Uri that this provider maps to a
             content:// Uri on any API level. -->
        <provider
            android:name=".ProjectFileProvider"
            android:authorities="com.example.hourstracker2.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>